static int AggressiveCows(int[]  stalls , int cows){
            if(stalls.length<cows){
                return 0;
            }

        Arrays.sort(stalls);


           int ans = -1;
            int start = 1;
            int end = stalls[stalls.length-1];

            while(start<=end){
                 int mid = start+(end-start)/2;
                if(AllocateCows(stalls,cows,mid)){
                  ans = mid ;
                    start = mid +1;
                }
                else {
                    end = mid-1;
                }

            }
return ans ;
    }

    static boolean AllocateCows(int[] stalls , int cows  , int mid ) {
        int count = 1;
        int cowsallocated = stalls[0];
        for (int i = 1; i < stalls.length; i++) {
            if ((stalls[i] - cowsallocated) >= mid) {
                cowsallocated = stalls[i];
                count++;
            }

            if (count >= cows) {
                return true;
            }
        }
        return false;
    }  }
