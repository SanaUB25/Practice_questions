static void MinimumAbsoluteDifference(int[] arr,int target){
               int start = 0;
               int end = arr.length-1;
               int ans =-1;

               while(start<=end){
                   int mid = start+(end-start)/2;
                   if(arr[mid]==target){
                       ans = mid;
                       break;
                   }
                   else if (arr[mid]<target){
                       start = mid+1;
                   }
                   else {
                       end = mid -1;
                   }
               }

               //If element does not exist;

        int res =0;
               if(ans ==-1){
                   if(end==-1){
                       res = Math.abs(target-arr[start]);
                   }
                   else if(start==arr.length){
                       res = Math.abs(target-arr[end]);

                   }
                   else{
                       int ans1 = Math.abs(target-arr[start]);
                       int ans2 =Math.abs(target-arr[end]);
                       res = (ans1<ans2)?ans1:ans2;
                   }
               }
        System.out.println(res);



    }
